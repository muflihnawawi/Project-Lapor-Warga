# Koneksi MySQL (XAMPP default: user root tanpa password)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=laporwarga

# Ganti dengan string acak panjang (minimal 32 karakter)
JWT_SECRET=ganti-dengan-string-acak-yang-panjang-sekali-123456
ACCESS_TOKEN_TTL=3600
REFRESH_TOKEN_DAYS=30

# Folder penyimpanan foto (relatif ke root proyek)
STORAGE_DIR=storage
